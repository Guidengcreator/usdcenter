{
  "name": "@uzd-expert/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "node --env-file=.env.development ../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.development --import tsx src/db/migrate.ts",
    "db:seed:admin": "node --env-file=.env.development --import tsx src/db/seed-admin-user.ts",
    "db:migrate:production": "node dist/db/migrate.js",
    "db:seed:clinic": "node --env-file=.env.development --import tsx src/db/seed-clinic-information.ts",
    "db:seed:clinic:production": "node dist/db/seed-clinic-information.js",
    "dev": "node --env-file=.env.development --import tsx --watch src/server.ts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"drizzle.config.ts\" \"vitest.config.ts\"",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
